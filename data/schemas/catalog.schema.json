{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "explorer": {"const":"explorer/archive.json"},
    "schema_version": {
      "const": "1.0.0"
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          },
          "fecha_corte": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "path": {
            "type": "string",
            "pattern": "^snapshots/[a-zA-Z0-9_-]+/snapshot\\.json$"
          }
        },
        "required": [
          "id",
          "fecha_corte",
          "path"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "snapshots"
  ]
}
