{
  "name": "ugd-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test",
    "test:browser": "node scripts/browser-check.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "preview:content": "node scripts/build.mjs --preview && node scripts/serve.mjs work/preview",
    "fixtures:synthetic": "node tests/fixtures/synthetic/generate.mjs",
    "preview:synthetic": "node tests/fixtures/synthetic/generate.mjs && node scripts/build.mjs --preview --content tests/fixtures/synthetic/content --media tests/fixtures/synthetic --archive-extra tests/fixtures/synthetic/archive-extra.json --out work/synthetic-preview && node scripts/serve.mjs work/synthetic-preview",
    "test:content-walkthrough": "node scripts/content-walkthrough.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs dist",
    "admin": "node scripts/admin-server.mjs",
    "admin:user": "node scripts/admin-user.mjs",
    "test:admin-browser": "node scripts/admin-browser-check.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
